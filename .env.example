# Copy this file to .env.local for local development, and add the same
# variables in Vercel (Project -> Settings -> Environment Variables).
# NEVER commit real values.

# ---- Public (safe to expose to the browser) ---------------------------------

# Canonical site URL (used for SEO, sitemap and share previews).
NEXT_PUBLIC_SITE_URL=https://threadcorestudios.com

# WhatsApp number in international format, DIGITS ONLY (no +, spaces or leading 0s).
# Example: 15551234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---- Server-only secrets (never prefix these with NEXT_PUBLIC_) -------------

# Supabase: Project Settings -> API.
# The service-role key bypasses Row Level Security. Keep it secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for customer artwork (created by supabase/schema.sql).
SUPABASE_ARTWORK_BUCKET=enquiry-artwork

# ---- Optional: email notification for each new enquiry (via Resend) ---------
# All three must be set to enable it. NOTIFY_EMAIL_TO may be comma-separated.
# NOTIFY_EMAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
